{
  "name": "@stacksjs/table",
  "version": "0.0.12",
  "description": "Typed, driver-based searching, filtering, sorting, and pagination for data tables",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE.md"
  ],
  "stacks": {
    "name": "table",
    "description": "Typed table drivers and an STX data table component",
    "directories": [
      "resources"
    ]
  },
  "scripts": {
    "build": "bun --bun build.ts",
    "demo:memory": "bun examples/memory.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:types": "bunx --bun tsc --noEmit",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "release:patch": "bunx --bun bumpx patch --commit --tag --push --yes"
  },
  "devDependencies": {
    "better-dx": "^0.2.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/table.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/table/issues"
  },
  "homepage": "https://github.com/stacksjs/table#readme",
  "keywords": [
    "table",
    "search",
    "pagination",
    "sorting",
    "filters",
    "algolia",
    "meilisearch",
    "typesense"
  ],
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier --fix"
      },
      "autoRestage": true
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
